{
  "version": 3,
  "routes": [
    {
      "handle": "filesystem"
    },
    {
      "src": "/api/(.*)",
      "dest": "https://pulse-hybrid-app-production.up.railway.app/api/$1"
    },
    {
      "src": "/((?!.*\\.).*)",
      "dest": "/index.html"
    }
  ],
  "overrides": {
    "manifest.json": {
      "contentType": "application/manifest+json"
    },
    "sw.js": {
      "contentType": "application/javascript"
    }
  }
}