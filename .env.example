# Pulse Hybrid App — Environment Variables Template
# Copy to .env for local development or configure in Railway Service Variables.
# NEVER commit real secrets or passwords to git.

# Server port (Railway injects PORT automatically)
PORT=8080

# API Security (set a strong random string in Railway to require auth on all /api/* routes)
PULSE_API_SECRET=
# Optional comma-separated list of allowed cross-origin frontend URLs (leave blank for same-origin only)
ALLOWED_ORIGINS=

# Persistent data directory (mount Railway Volume at /data)
DATA_DIR=/data
LIVE_STATE_PATH=/data/live_state.json

# Garmin Connect OAuth session storage
GARMIN_TOKEN_DIR=/data/garmin_tokens
# Optional: serialized Garmin OAuth token bundle JSON for headless deploys
GARMIN_TOKENS_JSON=

# MyNetDiary cloud sync credentials & session cache
MND_TOKEN_DIR=/data/mnd_tokens
MND_USERNAME=
MND_PASSWORD=

# Renpho scale cloud sync credentials
RENPHO_EMAIL=
RENPHO_PASSWORD=

# AI Injury Diagnostics & Triage Module (optional — falls back to deterministic biomechanical engine if unset)
GEMINI_API_KEY=
GEMINI_DIAGNOSTICS_MODEL=gemini-2.5-flash
